#. Plugin Name of the plugin
msgid "RHINNO IT - Customizer"
msgstr ""

#. Description of the plugin
msgid "Adjusts the WooCommerce cart, checkout, orders and store pickup."
msgstr ""

#. Author of the plugin
msgid "RHINNO IT"
msgstr ""

#. Author URI of the plugin
msgid "mailto:dev@rhinnoit.cloud"
msgstr ""

#: includes/admin/class-plugin-links.php
msgid "Settings"
msgstr ""

#: includes/admin/class-settings-page.php
msgid "You are not allowed to change these settings."
msgstr ""

#: includes/admin/class-settings-page.php
msgid "The plugin was updated while this screen was open, so nothing was saved. Check the settings below and save again."
msgstr ""

#: includes/admin/class-settings-page.php
msgid "Settings saved."
msgstr ""

#. translators: %s: minimum WooCommerce version.
#: includes/class-plugin.php
#, php-format
msgid "Customizer needs WooCommerce %s or higher, and does nothing until then."
msgstr ""

#: includes/class-plugin.php
msgid "Customizer waits until WP Optimizer is deactivated, and does nothing until then."
msgstr ""

#: includes/class-settings.php
msgid "Enable"
msgstr ""

#: includes/class-settings.php
msgid "If you turn it off, everything below stops, without deactivating the plugin."
msgstr ""

#: includes/class-settings.php
msgid "WooCommerce"
msgstr ""

#: includes/class-settings.php
msgid "Cart and checkout"
msgstr ""

#: includes/class-settings.php
msgid "Skip the cart for virtual products"
msgstr ""

#: includes/class-settings.php
msgid "After adding a product, shoppers go straight to checkout if the cart holds only virtual products."
msgstr ""

#: includes/class-settings.php
msgid "Skip the cart for any product"
msgstr ""

#: includes/class-settings.php
msgid "After adding any product, physical ones included, shoppers go straight to checkout."
msgstr ""

#: includes/class-settings.php
msgid "Show the regular price struck through"
msgstr ""

#: includes/class-settings.php
msgid "In the mini cart, cart and checkout, products on sale keep showing their discount. Check all three on a phone."
msgstr ""

#: includes/class-settings.php
msgid "Split cart coupons by price"
msgstr ""

#: includes/class-settings.php
msgid "A fixed cart discount is shared out by each product's price, so a cheap product never ends up free."
msgstr ""

#: includes/class-settings.php
msgid "Hide the coupon prompt"
msgstr ""

#: includes/class-settings.php
msgid "If the cart holds only virtual products, the classic checkout does not show the coupon field."
msgstr ""

#: includes/class-settings.php
msgid "Hide the login prompt"
msgstr ""

#: includes/class-settings.php
msgid "If the cart holds only virtual products, the classic checkout does not invite shoppers to log in."
msgstr ""

#: includes/class-settings.php
msgid "Pick the commune from a list"
msgstr ""

#: includes/class-settings.php
msgid "For an address in Chile, the classic checkout offers the chosen region's communes in a dropdown, like the region. Check the checkout on a phone."
msgstr ""

#: includes/class-settings.php
msgid "Check the RUT at checkout"
msgstr ""

#: includes/class-settings.php
msgid "If the classic checkout asks for a RUT, it is formatted as it is typed and an invalid one is refused, and a foreign customer can leave it out."
msgstr ""

#: includes/class-settings.php
msgid "Shipping methods by commune"
msgstr ""

#: includes/class-settings.php
msgid "Hide shipping methods in some communes"
msgstr ""

#: includes/class-settings.php
msgid "For an address in the communes below, the shipping methods below are not offered, and the cart and the classic checkout show the message. Check both."
msgstr ""

#: includes/class-settings.php
msgid "Shipping methods to hide"
msgstr ""

#: includes/class-settings.php
msgid "Listed by shipping zone: pick a method in every zone it should disappear from."
msgstr ""

#: includes/class-settings.php
msgid "Choose shipping methods…"
msgstr ""

#: includes/class-settings.php
msgid "Communes where they are hidden"
msgstr ""

#: includes/class-settings.php
msgid "Matched with the commune of the shipping address, whatever its accents or capitals."
msgstr ""

#: includes/class-settings.php
msgid "Choose communes…"
msgstr ""

#: includes/class-settings.php
msgid "Message for those communes"
msgstr ""

#: includes/class-settings.php
msgid "Shown with the shipping options; leave it empty to show nothing."
msgstr ""

#: includes/class-settings.php
msgid "Express delivery is not available for your commune. Please choose another shipping method."
msgstr ""

#: includes/class-settings.php
msgid "Deliveries by commune"
msgstr ""

#: includes/class-settings.php
msgid "Stop deliveries to some communes"
msgstr ""

#: includes/class-settings.php
msgid "For an address in the communes below, only store pickup is offered, and the cart and the classic checkout show the message. Check both."
msgstr ""

#: includes/class-settings.php
msgid "Communes without delivery"
msgstr ""

#: includes/class-settings.php
msgid "We cannot deliver to your commune for the time being. Please check your address, or contact us if you need help."
msgstr ""

#: includes/class-settings.php
msgid "Orders"
msgstr ""

#: includes/class-settings.php
msgid "Cancel unpaid orders on time"
msgstr ""

#: includes/class-settings.php
msgid "With a stock hold of 15 minutes or more, unpaid orders are cancelled soon after it ends."
msgstr ""

#: includes/class-settings.php
msgid "Avoid late Fintoc payments"
msgstr ""

#: includes/class-settings.php
msgid "The time to pay with Fintoc ends with the stock hold, instead of lasting 24 hours."
msgstr ""

#: includes/class-settings.php
msgid "Porto"
msgstr ""

#: includes/class-settings.php
msgid "Product widgets"
msgstr ""

#: includes/class-settings.php
msgid "Show sharp thumbnails"
msgstr ""

#: includes/class-settings.php
msgid "Thumbnails in widgets load at a higher resolution and stop looking blurry."
msgstr ""

#: includes/class-settings.php
msgid "Match the sale price color"
msgstr ""

#: includes/class-settings.php
msgid "The sale price in widgets uses the same color as on shop and category pages."
msgstr ""

#: includes/class-settings.php
msgid "Checkout"
msgstr ""

#: includes/class-settings.php
msgid "Match the birth date field"
msgstr ""

#: includes/class-settings.php
msgid "If the classic checkout asks for a birth date, its field looks like the others, with the calendar icon at its right. Check the checkout on a phone."
msgstr ""

#: includes/class-settings.php
msgid "WeLaunch Multi Inventory"
msgstr ""

#: includes/class-settings.php
msgid "Store picked"
msgstr ""

#: includes/class-settings.php
msgid "Keep the quick view's store choice"
msgstr ""

#: includes/class-settings.php
msgid "Adding from the quick view keeps the store the shopper picked."
msgstr ""

#: includes/class-settings.php
msgid "Remove the store from links"
msgstr ""

#: includes/class-settings.php
msgid "Links do not carry the last store used, so pages can keep loading from the cache."
msgstr ""

#: includes/class-settings.php
msgid "Let the shopper choose"
msgstr ""

#: includes/class-settings.php
msgid "Pickup stores never come ticked, and adding to the cart needs home delivery or a store ticked."
msgstr ""

#: includes/class-settings.php
msgid "Tick home delivery when in stock"
msgstr ""

#: includes/class-settings.php
msgid "Home delivery comes ticked when it has the size picked and the cart is empty or for home delivery. Requires \"Let the shopper choose\"."
msgstr ""

#: includes/class-settings.php
msgid "Hide stores without the size"
msgstr ""

#: includes/class-settings.php
msgid "Pickup stores show only if they have the size picked, and home delivery always does. Check the product page."
msgstr ""

#: includes/class-settings.php
msgid "Show each size's stores instantly"
msgstr ""

#: includes/class-settings.php
msgid "Shows which stores have the size as soon as it is picked, without waiting."
msgstr ""

#: includes/class-settings.php
msgid "Stock"
msgstr ""

#: includes/class-settings.php
msgid "Hold each store's stock"
msgstr ""

#: includes/class-settings.php
msgid "Keeps two shoppers from paying for a store's last unit at the same time."
msgstr ""

#: includes/frontend/class-commune-select.php
msgid "Choose a commune…"
msgstr ""

#: includes/frontend/class-commune-select.php
msgid "Choose the region first"
msgstr ""

#: includes/frontend/class-rut-validation.php
msgid "Please enter your RUT."
msgstr ""

#: includes/frontend/class-rut-validation.php
msgid "The RUT you entered is not valid. Please check it."
msgstr ""

