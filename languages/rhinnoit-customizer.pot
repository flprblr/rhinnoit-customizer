msgid "The shipping method you chose is not available for your commune. Please choose another one."
msgstr ""

#: includes/frontend/class-store-choice.php
msgid "Choose home delivery or a store to pick it up."
msgstr ""

#. translators: %s: store name.
#: includes/frontend/class-store-choice.php
#, php-format
msgid "%s does not take online orders. Choose home delivery or another store."
msgstr ""

#. translators: 1: product name, 2: store name, 3: units the store has.
#: includes/frontend/class-store-choice.php
#, php-format
msgid "%1$s: %3$d left at %2$s. Choose another location or fewer units."
msgstr ""

#. translators: %s: product name.
#: includes/frontend/class-store-choice.php
#, php-format
msgid "%s is not available online."
msgstr ""

#. translators: 1: product name, 2: store name, 3: units the store has.
#: includes/frontend/class-store-stock-hold.php
#, php-format
msgid "%1$s: %3$d left at %2$s. Place a new order and choose another location."
msgstr ""

