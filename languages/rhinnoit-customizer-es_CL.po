#. Plugin Name of the plugin
msgid "RHINNO IT - Customizer"
msgstr "RHINNO IT - Customizer"

#. Description of the plugin
msgid "Adjusts the WooCommerce cart, checkout, orders and store pickup."
msgstr "Ajusta el carrito, el pago, los pedidos y el retiro en tienda de WooCommerce."

#. Author of the plugin
msgid "RHINNO IT"
msgstr "RHINNO IT"

#. Author URI of the plugin
msgid "mailto:dev@rhinnoit.cloud"
msgstr "mailto:dev@rhinnoit.cloud"

#: includes/admin/class-plugin-links.php
msgid "Settings"
msgstr "Ajustes"

#: includes/admin/class-settings-page.php
msgid "You are not allowed to change these settings."
msgstr "No tienes permiso para cambiar estos ajustes."

#: includes/admin/class-settings-page.php
msgid "The plugin was updated while this screen was open, so nothing was saved. Check the settings below and save again."
msgstr "El plugin se actualizó mientras esta pantalla estaba abierta, así que no se guardó nada. Revisa los ajustes y vuelve a guardar."

#: includes/admin/class-settings-page.php
msgid "Settings saved."
msgstr "Ajustes guardados."

#. translators: %s: minimum WooCommerce version.
#: includes/class-plugin.php
#, php-format
msgid "Customizer needs WooCommerce %s or higher, and does nothing until then."
msgstr "Customizer necesita WooCommerce %s o superior, y no hace nada hasta entonces."

#: includes/class-plugin.php
msgid "Customizer waits until WP Optimizer is deactivated, and does nothing until then."
msgstr "Customizer espera a que se desactive WP Optimizer, y no hace nada hasta entonces."

#: includes/class-settings.php
msgid "Enable"
msgstr "Activar"

#: includes/class-settings.php
msgid "If you turn it off, everything below stops, without deactivating the plugin."
msgstr "Si lo apagas, todo lo de abajo se detiene, sin desactivar el plugin."

#: includes/class-settings.php
msgid "WooCommerce"
msgstr "WooCommerce"

#: includes/class-settings.php
msgid "Cart and checkout"
msgstr "Carrito y pago"

#: includes/class-settings.php
msgid "Skip the cart for virtual products"
msgstr "Saltar el carrito con productos virtuales"

#: includes/class-settings.php
msgid "After adding a product, shoppers go straight to checkout if the cart holds only virtual products."
msgstr "Al agregar un producto, el cliente va directamente a la página de pago si el carrito solo tiene productos virtuales."

#: includes/class-settings.php
msgid "Skip the cart for any product"
msgstr "Saltar el carrito con cualquier producto"

#: includes/class-settings.php
msgid "After adding any product, physical ones included, shoppers go straight to checkout."
msgstr "Al agregar cualquier producto, incluso uno físico, el cliente va directamente a la página de pago."

#: includes/class-settings.php
msgid "Show the regular price struck through"
msgstr "Mostrar el precio normal tachado"

#: includes/class-settings.php
msgid "In the mini cart, cart and checkout, products on sale keep showing their discount. Check all three on a phone."
msgstr "En el minicarrito, el carrito y la página de pago, los productos en oferta siguen mostrando su descuento. Revisa los tres en un teléfono."

#: includes/class-settings.php
msgid "Split cart coupons by price"
msgstr "Repartir los cupones del carrito según el precio"

#: includes/class-settings.php
msgid "A fixed cart discount is shared out by each product's price, so a cheap product never ends up free."
msgstr "Un descuento fijo en el carrito se reparte según el precio de cada producto, así uno barato nunca queda gratis."

#: includes/class-settings.php
msgid "Hide the coupon prompt"
msgstr "Ocultar el aviso de cupón"

#: includes/class-settings.php
msgid "If the cart holds only virtual products, the classic checkout does not show the coupon field."
msgstr "Si el carrito solo tiene productos virtuales, la página de pago clásica no muestra el campo de cupón."

#: includes/class-settings.php
msgid "Hide the login prompt"
msgstr "Ocultar el aviso para iniciar sesión"

#: includes/class-settings.php
msgid "If the cart holds only virtual products, the classic checkout does not invite shoppers to log in."
msgstr "Si el carrito solo tiene productos virtuales, la página de pago clásica no invita a iniciar sesión."

#: includes/class-settings.php
msgid "Pick the commune from a list"
msgstr "Elegir la comuna de una lista"

#: includes/class-settings.php
msgid "For an address in Chile, the classic checkout offers the chosen region's communes in a dropdown, like the region. Check the checkout on a phone."
msgstr "En una dirección de Chile, la página de pago clásica ofrece las comunas de la región elegida en un desplegable, como la región. Revisa la página de pago en un teléfono."

#: includes/class-settings.php
msgid "Check the RUT at checkout"
msgstr "Validar el RUT en la página de pago"

#: includes/class-settings.php
msgid "If the classic checkout asks for a RUT, it is formatted as it is typed and an invalid one is refused, and a foreign customer can leave it out."
msgstr "Si la página de pago clásica pide el RUT, se le da formato mientras se escribe y se rechaza uno inválido, y un cliente extranjero puede omitirlo."

#: includes/class-settings.php
msgid "Shipping methods by commune"
msgstr "Métodos de envío por comuna"

#: includes/class-settings.php
msgid "Hide shipping methods in some communes"
msgstr "Ocultar métodos de envío en algunas comunas"

#: includes/class-settings.php
msgid "For an address in the communes below, the shipping methods below are not offered, and the cart and the classic checkout show the message. Check both."
msgstr "En una dirección de las comunas de abajo no se ofrecen los métodos de envío de abajo, y el carrito y la página de pago clásica muestran el mensaje. Revisa ambos."

#: includes/class-settings.php
msgid "Shipping methods to hide"
msgstr "Métodos de envío que se ocultan"

#: includes/class-settings.php
msgid "Listed by shipping zone: pick a method in every zone it should disappear from."
msgstr "Aparecen por zona de envío: elige el método en cada zona de la que debe desaparecer."

#: includes/class-settings.php
msgid "Choose shipping methods…"
msgstr "Elige métodos de envío…"

#: includes/class-settings.php
msgid "Communes where they are hidden"
msgstr "Comunas donde se ocultan"

#: includes/class-settings.php
msgid "Matched with the commune of the shipping address, whatever its accents or capitals."
msgstr "Se comparan con la comuna de la dirección de envío, sin importar tildes ni mayúsculas."

#: includes/class-settings.php
msgid "Choose communes…"
msgstr "Elige comunas…"

#: includes/class-settings.php
msgid "Message for those communes"
msgstr "Mensaje para esas comunas"

#: includes/class-settings.php
msgid "Shown with the shipping options; leave it empty to show nothing."
msgstr "Se muestra junto a las opciones de envío; déjalo vacío para no mostrar nada."

#: includes/class-settings.php
msgid "Express delivery is not available for your commune. Please choose another shipping method."
msgstr "El despacho express no está disponible para tu comuna. Por favor, elige otro método de envío."

#: includes/class-settings.php
msgid "Deliveries by commune"
msgstr "Despachos por comuna"

#: includes/class-settings.php
msgid "Stop deliveries to some communes"
msgstr "Suspender los despachos a algunas comunas"

#: includes/class-settings.php
msgid "For an address in the communes below, only store pickup is offered, and the cart and the classic checkout show the message. Check both."
msgstr "En una dirección de las comunas de abajo solo se ofrece el retiro en tienda, y el carrito y la página de pago clásica muestran el mensaje. Revisa ambos."

#: includes/class-settings.php
msgid "Communes without delivery"
msgstr "Comunas sin despacho"

#: includes/class-settings.php
msgid "We cannot deliver to your commune for the time being. Please check your address, or contact us if you need help."
msgstr "Por ahora no podemos despachar a tu comuna. Revisa tu dirección o contáctanos si necesitas ayuda."

#: includes/class-settings.php
msgid "Orders"
msgstr "Pedidos"

#: includes/class-settings.php
msgid "Cancel unpaid orders on time"
msgstr "Cancelar a tiempo los pedidos sin pagar"

#: includes/class-settings.php
msgid "With a stock hold of 15 minutes or more, unpaid orders are cancelled soon after it ends."
msgstr "Si la reserva de stock dura 15 minutos o más, los pedidos sin pagar se cancelan poco después de que termine."

#: includes/class-settings.php
msgid "Avoid late Fintoc payments"
msgstr "Evitar pagos tardíos con Fintoc"

#: includes/class-settings.php
msgid "The time to pay with Fintoc ends with the stock hold, instead of lasting 24 hours."
msgstr "El plazo para pagar con Fintoc termina con la reserva de stock, en vez de durar 24 horas."

#: includes/class-settings.php
msgid "Porto"
msgstr "Porto"

#: includes/class-settings.php
msgid "Product widgets"
msgstr "Widgets de productos"

#: includes/class-settings.php
msgid "Show sharp thumbnails"
msgstr "Mostrar miniaturas nítidas"

#: includes/class-settings.php
msgid "Thumbnails in widgets load at a higher resolution and stop looking blurry."
msgstr "Las miniaturas de los widgets cargan en mayor resolución y dejan de verse borrosas."

#: includes/class-settings.php
msgid "Match the sale price color"
msgstr "Igualar el color del precio de oferta"

#: includes/class-settings.php
msgid "The sale price in widgets uses the same color as on shop and category pages."
msgstr "El precio de oferta de los widgets usa el mismo color que en la tienda y las categorías."

#: includes/class-settings.php
msgid "Checkout"
msgstr "Página de pago"

#: includes/class-settings.php
msgid "Match the birth date field"
msgstr "Igualar el campo de fecha de nacimiento"

#: includes/class-settings.php
msgid "If the classic checkout asks for a birth date, its field looks like the others, with the calendar icon at its right. Check the checkout on a phone."
msgstr "Si la página de pago clásica pide la fecha de nacimiento, su campo se ve como los demás, con el botón del calendario a la derecha. Revisa la página de pago en un teléfono."

#: includes/class-settings.php
msgid "WeLaunch Multi Inventory"
msgstr "WeLaunch Multi Inventory"

#: includes/class-settings.php
msgid "Store picked"
msgstr "Tienda elegida"

#: includes/class-settings.php
msgid "Keep the quick view's store choice"
msgstr "Mantener la tienda elegida en la vista rápida"

#: includes/class-settings.php
msgid "Adding from the quick view keeps the store the shopper picked."
msgstr "Al agregar desde la vista rápida, se mantiene la tienda que eligió el cliente."

#: includes/class-settings.php
msgid "Remove the store from links"
msgstr "Quitar la tienda de los enlaces"

#: includes/class-settings.php
msgid "Links do not carry the last store used, so pages can keep loading from the cache."
msgstr "Los enlaces no llevan la última tienda usada, así las páginas pueden seguir cargando desde la caché."

#: includes/class-settings.php
msgid "Let the shopper choose"
msgstr "Dejar que el cliente elija"

#: includes/class-settings.php
msgid "Pickup stores never come ticked, and adding to the cart needs home delivery or a store ticked."
msgstr "Las tiendas de retiro nunca vienen marcadas, y para agregar al carrito hay que marcar despacho a domicilio o una tienda."

#: includes/class-settings.php
msgid "Tick home delivery when in stock"
msgstr "Marcar despacho a domicilio si hay stock"

#: includes/class-settings.php
msgid "Home delivery comes ticked when it has the size picked and the cart is empty or for home delivery. Requires \"Let the shopper choose\"."
msgstr "El despacho a domicilio viene marcado si tiene la talla elegida y el carrito está vacío o es para despacho. Requiere «Dejar que el cliente elija»."

#: includes/class-settings.php
msgid "Hide stores without the size"
msgstr "Ocultar las tiendas sin la talla"

#: includes/class-settings.php
msgid "Pickup stores show only if they have the size picked, and home delivery always does. Check the product page."
msgstr "Solo se ven las tiendas de retiro con la talla elegida, y el despacho a domicilio siempre. Revisa la página de producto."

#: includes/class-settings.php
msgid "Show each size's stores instantly"
msgstr "Mostrar al instante las tiendas de cada talla"

#: includes/class-settings.php
msgid "Shows which stores have the size as soon as it is picked, without waiting."
msgstr "Muestra qué tiendas tienen la talla al elegirla, sin esperar."

#: includes/class-settings.php
msgid "Stock"
msgstr "Stock"

#: includes/class-settings.php
msgid "Hold each store's stock"
msgstr "Reservar el stock de cada tienda"

#: includes/class-settings.php
msgid "Keeps two shoppers from paying for a store's last unit at the same time."
msgstr "Evita que dos clientes paguen a la vez la última unidad de una tienda."

#: includes/frontend/class-commune-select.php
msgid "Choose a commune…"
msgstr "Elige una comuna…"

#: includes/frontend/class-commune-select.php
msgid "Choose the region first"
msgstr "Elige primero la región"

#: includes/frontend/class-rut-validation.php
msgid "Please enter your RUT."
msgstr "Por favor, escribe tu RUT."

#: includes/frontend/class-rut-validation.php
msgid "The RUT you entered is not valid. Please check it."
msgstr "El RUT no es válido. Por favor, revísalo."

#. translators: %s: a shipping zone and one of its methods, as "Zone: method".
#: includes/frontend/class-shipping-block.php
#, php-format
msgid "%s (disabled)"
msgstr "%s (desactivado)"

#: includes/frontend/class-shipping-communes.php
msgid "The shipping method you chose is not available for your commune. Please choose another one."
msgstr "El método de envío que elegiste no está disponible para tu comuna. Por favor, elige otro."

#: includes/frontend/class-store-choice.php
msgid "Choose home delivery or a store to pick it up."
msgstr "Elige despacho a domicilio o una tienda para retirar."

#. translators: %s: store name.
#: includes/frontend/class-store-choice.php
#, php-format
msgid "%s does not take online orders. Choose home delivery or another store."
msgstr "%s no recibe pedidos en línea. Elige despacho a domicilio u otra tienda."

#. translators: 1: product name, 2: store name, 3: units the store has.
#: includes/frontend/class-store-choice.php
#, php-format
msgid "%1$s: %3$d left at %2$s. Choose another location or fewer units."
msgstr "%1$s: quedan %3$d en %2$s. Elige otra ubicación o menos unidades."

#. translators: %s: product name.
#: includes/frontend/class-store-choice.php
#, php-format
msgid "%s is not available online."
msgstr "%s no está disponible en línea."

#. translators: 1: product name, 2: store name, 3: units the store has.
#: includes/frontend/class-store-stock-hold.php
#, php-format
msgid "%1$s: %3$d left at %2$s. Place a new order and choose another location."
msgstr "%1$s: quedan %3$d en %2$s. Haz un nuevo pedido y elige otra ubicación."

#. translators: 1: product name, 2: store name, 3: units the store can still sell.
#: includes/frontend/class-store-stock-hold.php
#, php-format
msgid "%1$s: %3$d left at %2$s while other customers complete their payment. Choose another location or fewer units, or try again in a few minutes."
msgstr "%1$s: quedan %3$d en %2$s mientras otros clientes completan su pago. Elige otra ubicación o menos unidades, o inténtalo de nuevo en unos minutos."
